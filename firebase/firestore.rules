rules_version = '2';

// Publique com: firebase deploy --only firestore:rules
// As regras protegem os dados; o JavaScript apenas controla a interface.
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function ehAdmin() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.cargos.hasAny(['admin']);
    }

    // Catálogo público; itens ocultos continuam exclusivos do administrador.
    match /produtos/{produtoId} {
      allow get: if resource.data.status != 'oculto' || ehAdmin();
      allow list: if resource.data.status in ['disponivel', 'sem_estoque', 'esgotado'] || ehAdmin();
      allow create, update, delete: if ehAdmin();
    }

    match /custosProdutos/{produtoId} {
      allow read, write: if ehAdmin();
    }

    match /categorias/{id} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    match /etiquetas/{id} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    match /marcas/{id} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    match /categoriasServico/{id} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    match /servicos/{servicoId} {
      allow get: if resource.data.status != 'oculto' || ehAdmin();
      allow list: if resource.data.status == 'disponivel' || ehAdmin();
      allow create, update, delete: if ehAdmin();
    }

    // Documento usado para avisar a vitrine sobre mudanças no catálogo.
    match /publicacoes/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if ehAdmin();
    }

    // A leitura do próprio perfil é essencial para saber se a conta é admin.
    match /usuarios/{uid} {
      allow get: if autenticado() && (request.auth.uid == uid || ehAdmin());
      allow list: if ehAdmin();
      allow create: if autenticado()
        && request.auth.uid == uid
        && request.resource.data.cargos == ['cliente'];
      allow update: if ehAdmin() || (
        autenticado()
        && request.auth.uid == uid
        && request.resource.data.cargos == resource.data.cargos
        && request.resource.data.email == resource.data.email
      );
      allow delete: if ehAdmin();
    }

    match /clientes/{id} {
      allow read, write: if ehAdmin();
    }

    // Um cliente só acessa os próprios pedidos; o administrador acessa todos.
    match /pedidos/{id} {
      allow create: if autenticado()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.keys().hasAll(['usuarioId', 'itens', 'total', 'criadoEm'])
        && request.resource.data.itens is list
        && request.resource.data.itens.size() > 0
        && request.resource.data.itens.size() <= 100
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && (!('status' in request.resource.data) || request.resource.data.status == 'pendente');
      allow read: if autenticado() && (resource.data.usuarioId == request.auth.uid || ehAdmin());
      allow update: if ehAdmin();
      allow delete: if autenticado() && (resource.data.usuarioId == request.auth.uid || ehAdmin());
    }

    match /enderecos/{id} {
      allow create: if autenticado() && request.resource.data.usuarioId == request.auth.uid;
      allow read, update, delete: if autenticado()
        && (resource.data.usuarioId == request.auth.uid || ehAdmin());
    }

    match /carrinhos/{uid} {
      allow read, write: if autenticado() && request.auth.uid == uid;
    }

    match /favoritos/{uid} {
      allow read, write: if autenticado() && request.auth.uid == uid;
    }

    match /historicoEstoque/{id} {
      allow read, write: if ehAdmin();
    }

    match /leadsPerdidos/{id} {
      allow read, update, delete: if ehAdmin();
      // Criação é feita pela API com Admin SDK, que não depende desta regra.
      allow create: if false;
    }

    match /alertasEstoque/{id} {
      allow read: if ehAdmin();
      allow write: if false;
    }

    match /logsErros/{id} {
      allow create: if autenticado();
      allow read, update, delete: if ehAdmin();
    }
  }
}
